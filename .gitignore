node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not source media you import into public/.
out

# Local model/binary caches (large, re-downloadable)
pipeline/.cache/

# Contact-sheet thumbnails: re-derivable from media manifest + scene-plan, and the
# durable/shareable copy already lives in the published Claude Artifact.
pipeline/videos/*/contact-sheet/

# Giai đoạn 0 MVP (Google Flow browser-automation agent) — thử nghiệm ngoài pipeline chính
# thức, chưa "tốt nghiệp". Chứa profile trình duyệt = session cookie đăng nhập Google thật,
# tuyệt đối không commit. Toàn bộ thư mục bỏ qua cho đến khi được duyệt đưa vào scripts/.
experiments/flow-media-agent/

# Profile trình duyệt dùng chung cho scripts/02b-media-generate.router.mjs (đăng nhập Google
# Flow) — KHÔNG theo từng video, dùng lại cho mọi lần chạy. Chứa session cookie đăng nhập
# Google thật, tuyệt đối không commit.
pipeline/.flow-profile/

# HyperFrames renders (tái tạo được bằng `hyperframes render`, cùng tinh thần loại trừ "out" ở
# trên) + project test tạm của codegen (dọn tự động khi PASS, có thể sót khi FAIL).
hyperframes/videos/*/renders/
hyperframes/.gen-tmp/

# Cache nội bộ của `hyperframes preview`/Studio (thumbnail, waveform scrubbing) — tái tạo được
# tự động khi mở lại preview, không phải nguồn thật của composition.
hyperframes/videos/*/.thumbnails/
hyperframes/videos/*/.waveform-cache/

# Asset copy tất định từ public/videos/*/media/* vào project HyperFrames — trùng lặp binary với
# nguồn đã có trong public/, tái tạo được bằng cách chạy lại scripts/07-codegen.hf.router.mjs /
# 08-sync-root.hf.mjs, không cần lưu 2 bản trong git.
hyperframes/videos/*/assets/

# POC HyperFrames (poc/hyperframes/): giữ lại code (*.mjs) + kết quả log nhẹ
# (poc-results/*.json), bỏ output nặng tái tạo được (render/snapshot/asset copy/frame so sánh).
poc/hyperframes/*/render*.mp4
poc/hyperframes/*/snapshots/
poc/hyperframes/*/assets/
poc/hyperframes/compare-frames*/
poc/hyperframes/*/check-*.json
poc/hyperframes/*/check-*.txt

# model-compare/ (POC đổi model Stage 7, xem responsibility-matrix.md mục 6): project lồng thêm
# 1 cấp (poc/hyperframes/model-compare/<project>/assets/) nên pattern "*/assets/" ở trên không
# khớp (gitignore "*" không băng qua "/") — đã xác nhận bằng `git check-ignore -v` trước khi thêm
# dòng riêng này, không suy đoán.
poc/hyperframes/model-compare/*/assets/

# Stage 2c (PDF bản án): trang PDF render thô — tái tạo được bằng scripts/02c-pdf-source.local.mjs.
**/pipeline/videos/*/case-source/pages/

# POC PDF: bản sao tối thiểu của .agents/ và planning/style-dna/ (chép lại từ gốc repo, xem poc/pdf-source/README.md)
poc/pdf-source/.agents/
poc/pdf-source/planning/style-dna/
poc/pdf-source/hyperframes/.gen-tmp/
